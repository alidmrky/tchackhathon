# Jira Data Center URL (trailing slash olmadan)
# Örnek: https://jira.your-company.com
JIRA_BASE_URL=https://your-jira-domain.com

# Jira Personal Access Token (PAT)
# Oluşturmak için: Jira → Profil → Personal Access Tokens → Create Token
# NOT: Basic Auth değil, Bearer Token kullanılır
JIRA_API_TOKEN=your-jira-personal-access-token-here

# Backend port numarası (varsayılan: 5000)
PORT=5000
